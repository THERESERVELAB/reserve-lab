# ── App ──────────────────────────────────────────────────────────────────
# Public origin of the deployment (http://localhost:3000 in dev). This is the
# only site-origin variable the app reads — Stripe return URLs fall back to
# http://localhost:3000 when it is unset. NEXT_PUBLIC_SITE_URL is NOT read.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (REQUIRED for launch: auth + cloud member state) ────────────
# Project → Settings → API. URL + anon key are safe for the browser (RLS
# enforces access); ordinary member reads/writes use these + the member's
# verified session, never the service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — required for production; never expose or prefix NEXT_PUBLIC_.
# Used after request authentication for canonical profile bootstrap, complete
# account export/deletion, Stripe webhooks, and other privileged operations.
# Member API routes still derive ownership from a verified bearer token; this
# key is never itself treated as user authorization.
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase CLI (migrations only — no application code reads these) ─────
# The project ref is the 20-lowercase-letter subdomain of the project URL:
# https://<ref>.supabase.co. It must match that host exactly, or `supabase
# link` will target the wrong project. It is not a project name.
SUPABASE_PROJECT_REF=
# Database password, used by `supabase link` / `supabase db push`.
# SERVER/LOCAL ONLY — never prefix NEXT_PUBLIC_, never commit.
SUPABASE_DB_PASSWORD=

# ── Stripe (optional until billing goes live) ────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CORE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=

# ── OpenAI (optional; AI routes degrade gracefully without it) ───────────
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Connected health sources (WHOOP) ─────────────────────────────────────
# SERVER ONLY. 32 bytes, base64 (or 64 hex chars). Seals every stored
# third-party credential before it reaches the database. There is NO plaintext
# fallback: without this, Reserve refuses to store a WHOOP token at all.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it invalidates existing connections, which must then be reconnected.
RESERVE_TOKEN_ENCRYPTION_KEY=

# Your app from developer.whoop.com. The secret is SERVER ONLY — never prefix
# it with NEXT_PUBLIC_. See docs/WHOOP_CONNECTION.md for the walkthrough.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must match a redirect URI registered on the WHOOP app EXACTLY, character for
# character. Left unset, it is derived as NEXT_PUBLIC_APP_URL +
# /api/integrations/whoop/callback.
WHOOP_REDIRECT_URI=

# ── Demo mode ─────────────────────────────────────────────────────────────
# "true" seeds sample recovery/physique records for demos ONLY.
# Leave unset in production — real members must start with honest empty state.
NEXT_PUBLIC_ENABLE_DEMO_DATA=

# ── Verified deep links (Universal Links / App Links) ────────────────────
# Both are PUBLIC identifiers, not secrets — but a wrong value is worse than
# an unset one, because both platforms cache the association file. Left
# unset, /.well-known/* serves 404 and links open the browser as they do
# today. `npm run mobile:doctor` blocks a store build until both are set.
#
# Ten alphanumeric characters, Apple Developer account -> Membership.
RESERVE_IOS_TEAM_ID=
# SHA-256 of the key that signs the STORE build — Play Console -> Setup ->
# App signing. Upper-case hex, colon separated. A local debug keystore
# fingerprint verifies in testing and fails on the released app.
RESERVE_ANDROID_CERT_SHA256=
